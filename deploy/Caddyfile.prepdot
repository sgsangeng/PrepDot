api.prepdot.site {
    encode zstd gzip
    reverse_proxy prepdot-backend:8080
}

# 统一使用 apex 域名：JWT 存在 localStorage，按 origin 隔离，
# 在 www 上登录不会带到 prepdot.site，因此整体 301 到 apex。
www.prepdot.site {
    redir https://prepdot.site{uri} permanent
}

prepdot.site {
    encode zstd gzip

    handle /api/* {
        reverse_proxy prepdot-backend:8080
    }

    handle /welcome {
        redir /welcome /welcome/ permanent
    }

    handle /welcome/* {
        root * /srv/legal/prepdot-site
        file_server
    }

    handle {
        root * /srv/legal/prepdot-site/app
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
