server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/prepdot?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: root
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto

# Knife4j
knife4j:
  enable: true
  setting:
    language: zh_cn

# JWT 配置
jwt:
  secret: "replace-with-a-random-secret-at-least-32-chars-long"
  expire-days: 30

# AI 配置
ai:
  deepseek:
    api-url: https://api.deepseek.com/v1/chat/completions
    # 系统 Key（留空则纯靠用户自己填 Key）
    system-key: ""
    model: deepseek-chat
  agent:
    max-iterations: 8
    critic-max-retries: 2

# 本地开发：复制此文件为 application.yml（已在 .gitignore 中忽略），
# 填入真实的数据库密码 / JWT secret / DeepSeek key 后使用。
